<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="multisensor_fusion_rover">

  <!-- Color Definitions -->
  <material name="chassis_dark">
    <color rgba="0.12 0.12 0.15 1.0"/>
  </material>
  <material name="jetson_green">
    <color rgba="0.0 0.65 0.25 1.0"/>
  </material>
  <material name="wheel_dark">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="tof_amber">
    <color rgba="1.0 0.6 0.0 1.0"/>
  </material>
  <material name="bno_blue">
    <color rgba="0.0 0.4 0.9 1.0"/>
  </material>
  <material name="antenna_silver">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <!-- Footprint -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <!-- Main Chassis -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.20 0.08"/>
      </geometry>
      <material name="chassis_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.26 0.20 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="2.8"/>
      <inertia ixx="0.015" ixy="0.0" ixz="0.0" iyy="0.022" iyz="0.0" izz="0.028"/>
    </inertial>
  </link>

  <!-- NVIDIA Jetson Orin Nano Representation -->
  <link name="jetson_orin_nano_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.08 0.03"/>
      </geometry>
      <material name="jetson_green"/>
    </visual>
  </link>
  <joint name="jetson_joint" type="fixed">
    <parent link="base_link"/>
    <child link="jetson_orin_nano_link"/>
    <origin xyz="0.0 0 0.095" rpy="0 0 0"/>
  </joint>

  <!-- Wheel Macro -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="0.035"/>
        </geometry>
        <material name="wheel_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="0.035"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0005"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x_reflect * 0.08} ${y_reflect * 0.12} 0.0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="front_left" x_reflect="1" y_reflect="1"/>
  <xacro:wheel prefix="front_right" x_reflect="1" y_reflect="-1"/>
  <xacro:wheel prefix="rear_left" x_reflect="-1" y_reflect="1"/>
  <xacro:wheel prefix="rear_right" x_reflect="-1" y_reflect="-1"/>

  <!-- BNO085 9-Axis IMU Sensor -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
      <material name="bno_blue"/>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Wi-Fi Antenna Link -->
  <link name="wifi_antenna_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.14"/>
      </geometry>
      <material name="antenna_silver"/>
    </visual>
  </link>
  <joint name="wifi_antenna_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wifi_antenna_link"/>
    <origin xyz="-0.09 0.0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- 4x VL53L0X ToF Distance Sensors (Front, Left, Right, Rear) -->
  <link name="tof_front_link">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.01 0.025 0.01"/></geometry><material name="tof_amber"/></visual>
  </link>
  <joint name="tof_front_joint" type="fixed">
    <parent link="base_link"/><child link="tof_front_link"/><origin xyz="0.135 0.0 0.04" rpy="0 0 0"/>
  </joint>

  <link name="tof_left_link">
    <visual><origin xyz="0 0 0" rpy="0 0 1.5707963"/><geometry><box size="0.01 0.025 0.01"/></geometry><material name="tof_amber"/></visual>
  </link>
  <joint name="tof_left_joint" type="fixed">
    <parent link="base_link"/><child link="tof_left_link"/><origin xyz="0.0 0.105 0.04" rpy="0 0 1.5707963"/>
  </joint>

  <link name="tof_right_link">
    <visual><origin xyz="0 0 0" rpy="0 0 -1.5707963"/><geometry><box size="0.01 0.025 0.01"/></geometry><material name="tof_amber"/></visual>
  </link>
  <joint name="tof_right_joint" type="fixed">
    <parent link="base_link"/><child link="tof_right_link"/><origin xyz="0.0 -0.105 0.04" rpy="0 0 -1.5707963"/>
  </joint>

  <link name="tof_rear_link">
    <visual><origin xyz="0 0 0" rpy="0 0 3.1415926"/><geometry><box size="0.01 0.025 0.01"/></geometry><material name="tof_amber"/></visual>
  </link>
  <joint name="tof_rear_joint" type="fixed">
    <parent link="base_link"/><child link="tof_rear_link"/><origin xyz="-0.135 0.0 0.04" rpy="0 0 3.1415926"/>
  </joint>

  <!-- Gazebo Kinematics DiffDrive Motion Plugin (Strict 1 left joint, 1 right joint specification) -->
  <gazebo>
    <plugin filename="ign-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.24</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

  <!-- Gazebo Sensor Plugins -->
  <gazebo reference="imu_link">
    <sensor name="bno085_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/imu/data</topic>
    </sensor>
  </gazebo>

  <gazebo reference="tof_front_link">
    <sensor name="tof_front_sensor" type="ray">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <ray>
        <scan><horizontal><samples>1</samples><resolution>1</resolution><min_angle>0.0</min_angle><max_angle>0.0</max_angle></horizontal></scan>
        <range><min>0.03</min><max>2.0</max><resolution>0.001</resolution></range>
      </ray>
      <topic>/tof/sim/front</topic>
    </sensor>
  </gazebo>

  <gazebo reference="tof_left_link">
    <sensor name="tof_left_sensor" type="ray">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <ray>
        <scan><horizontal><samples>1</samples><resolution>1</resolution><min_angle>0.0</min_angle><max_angle>0.0</max_angle></horizontal></scan>
        <range><min>0.03</min><max>2.0</max><resolution>0.001</resolution></range>
      </ray>
      <topic>/tof/sim/left</topic>
    </sensor>
  </gazebo>

  <gazebo reference="tof_right_link">
    <sensor name="tof_right_sensor" type="ray">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <ray>
        <scan><horizontal><samples>1</samples><resolution>1</resolution><min_angle>0.0</min_angle><max_angle>0.0</max_angle></horizontal></scan>
        <range><min>0.03</min><max>2.0</max><resolution>0.001</resolution></range>
      </ray>
      <topic>/tof/sim/right</topic>
    </sensor>
  </gazebo>

  <gazebo reference="tof_rear_link">
    <sensor name="tof_rear_sensor" type="ray">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <ray>
        <scan><horizontal><samples>1</samples><resolution>1</resolution><min_angle>0.0</min_angle><max_angle>0.0</max_angle></horizontal></scan>
        <range><min>0.03</min><max>2.0</max><resolution>0.001</resolution></range>
      </ray>
      <topic>/tof/sim/rear</topic>
    </sensor>
  </gazebo>

</robot>
