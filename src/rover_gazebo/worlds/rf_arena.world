<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="multisensor_rf_arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"></plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"></plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"></plugin>

    <!-- Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Perimeter Room Outer Walls -->
    <model name="room_wall_south">
      <static>true</static><pose>5 0 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10 0.15 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10 0.15 2.0</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>

    <model name="room_wall_north">
      <static>true</static><pose>5 10 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10 0.15 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10 0.15 2.0</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>

    <model name="room_wall_west">
      <static>true</static><pose>0 5 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 10 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.15 10 2.0</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>

    <model name="room_wall_east">
      <static>true</static><pose>10 5 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 10 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.15 10 2.0</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>

    <!-- REAL-WORLD INDOOR FURNITURE -->

    <!-- Office Conference Table 1 at (3.5, 3.5) -->
    <model name="office_table_1">
      <static>true</static><pose>3.5 3.5 0.375 0 0 0</pose>
      <link name="top">
        <collision name="c"><geometry><box><size>1.6 0.9 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 0.9 0.05</size></box></geometry><material><ambient>0.4 0.25 0.15 1</ambient></material></visual>
      </link>
    </model>

    <!-- Office Conference Table 2 at (6.5, 6.5) -->
    <model name="office_table_2">
      <static>true</static><pose>6.5 6.5 0.375 0 0 0</pose>
      <link name="top">
        <collision name="c"><geometry><box><size>1.6 0.9 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 0.9 0.05</size></box></geometry><material><ambient>0.2 0.2 0.25 1</ambient></material></visual>
      </link>
    </model>

    <!-- Lab Storage Cabinet at (1.2, 7.5) -->
    <model name="storage_cabinet">
      <static>true</static><pose>1.2 7.5 0.70 0 0 0</pose>
      <link name="cabinet">
        <collision name="c"><geometry><box><size>0.6 1.4 1.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 1.4 1.4</size></box></geometry><material><ambient>0.3 0.35 0.4 1</ambient></material></visual>
      </link>
    </model>

    <!-- Bookshelf Unit at (8.8, 2.5) -->
    <model name="bookshelf_unit">
      <static>true</static><pose>8.8 2.5 0.80 0 0 0</pose>
      <link name="shelf">
        <collision name="c"><geometry><box><size>0.5 1.2 1.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 1.2 1.6</size></box></geometry><material><ambient>0.45 0.3 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- ROVER ROBOT MODEL EMBEDDED IN WORLD -->
    <model name="multisensor_fusion_rover">
      <pose>1.5 1.5 0.08 0 0 0</pose>

      <link name="base_footprint"><pose>0 0 0 0 0 0</pose></link>

      <link name="base_link">
        <pose>0 0 0.05 0 0 0</pose>
        <inertial><mass>3.5</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.03</izz></inertia></inertial>
        <collision name="chassis_collision"><geometry><box><size>0.25 0.20 0.08</size></box></geometry></collision>
        <visual name="chassis_visual"><geometry><box><size>0.25 0.20 0.08</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
      </link>

      <joint name="base_footprint_joint" type="fixed">
        <parent>base_footprint</parent><child>base_link</child>
      </joint>

      <!-- Wheels -->
      <link name="front_left_wheel">
        <pose>0.08 0.11 0.04 -1.570796 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      </link>
      <joint name="front_left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>front_left_wheel</child><axis><xyz>0 0 1</xyz></axis>
      </joint>

      <link name="front_right_wheel">
        <pose>0.08 -0.11 0.04 -1.570796 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      </link>
      <joint name="front_right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>front_right_wheel</child><axis><xyz>0 0 1</xyz></axis>
      </joint>

      <link name="rear_left_wheel">
        <pose>-0.08 0.11 0.04 -1.570796 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      </link>
      <joint name="rear_left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>rear_left_wheel</child><axis><xyz>0 0 1</xyz></axis>
      </joint>

      <link name="rear_right_wheel">
        <pose>-0.08 -0.11 0.04 -1.570796 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.04</radius><length>0.025</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      </link>
      <joint name="rear_right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>rear_right_wheel</child><axis><xyz>0 0 1</xyz></axis>
      </joint>

      <!-- Diff Drive Plugin -->
      <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>front_left_wheel_joint</left_joint>
        <left_joint>rear_left_wheel_joint</left_joint>
        <right_joint>front_right_wheel_joint</right_joint>
        <right_joint>rear_right_wheel_joint</right_joint>
        <wheel_separation>0.22</wheel_separation>
        <wheel_radius>0.04</wheel_radius>
        <odom_publish_frequency>30</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
      </plugin>
    </model>

  </world>
</sdf>
